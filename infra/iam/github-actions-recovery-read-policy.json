{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadTaskDefinitionsForRecoveryPreflight",
      "Effect": "Allow",
      "Action": "ecs:DescribeTaskDefinition",
      "Resource": "*",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "eu-central-1"
        }
      }
    }
  ]
}
